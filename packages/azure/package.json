{
  "name": "@revopush/config-azure-keyvault",
  "version": "0.2.0",
  "description": "Azure Key Vault secret provider for @revopush/config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revopush/config.git",
    "directory": "packages/azure"
  },
  "homepage": "https://revopush.org/",
  "bugs": {
    "url": "https://github.com/revopush/config/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@revopush/config": "^0.2.0"
  },
  "dependencies": {
    "@azure/identity": "^4.9.1",
    "@azure/keyvault-secrets": "^4.9.0"
  },
  "keywords": [
    "azure",
    "key-vault",
    "keyvault",
    "secrets",
    "secret-provider",
    "config",
    "configuration",
    "revopush",
    "typescript",
    "node"
  ],
  "author": "Revopush",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
