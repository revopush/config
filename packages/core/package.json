{
  "name": "@revopush/config",
  "version": "0.2.0",
  "description": "Layered configuration for Node services: schema-validated, per-environment and per-region, with pluggable value sources and secret providers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revopush/config.git",
    "directory": "packages/core"
  },
  "homepage": "https://revopush.org/",
  "bugs": {
    "url": "https://github.com/revopush/config/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "revopush-config": "./dist/codegen/bin.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "convict": "^6.2.5"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6"
  },
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "keywords": [
    "config",
    "configuration",
    "convict",
    "schema",
    "validation",
    "env",
    "environment",
    "secrets",
    "12-factor",
    "layered",
    "typescript",
    "node"
  ],
  "author": "Revopush",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
