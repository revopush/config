{
  "name": "revopush-config-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.15.2",
    "tsup": "^8.3.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
